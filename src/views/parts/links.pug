//- Resource links — official repos, ecosystem tools and community channels.
//- Same grid as electerm.org; the URLs come from linkCategories in bin/data.js.

section.links-section
  .container
    .section-header
      h2 electerm links
      p Official repositories, ecosystem tools and community channels.
    .links-grid
      each category in linkCategories
        .link-category
          h3= category.key
          ul.link-list
            each link in category.links
              if link.external
                li: a(href=link.url, target='_blank', rel='noreferrer')= link.title
              else
                li: a(href=link.url)= link.title
