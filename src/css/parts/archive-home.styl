/* ===== Release-archive home page ===== */

/* Header: the logo doubles as the site name, with a small tag so the archive
   is distinguishable from electerm.org at a glance. */
.header-logo-tag
  padding 2px 8px
  border-radius 999px
  background var(--color-primary-light)
  color var(--color-primary)
  font-size 0.68rem
  font-weight 600
  letter-spacing 0.04em
  text-transform uppercase
  white-space nowrap

@media (max-width: 479px)
  .header-logo-tag
    display none

/* --- Hero --- */

.hero-archive
  padding 72px 0 64px

/* electerm.org hides the hero <h1> because the logo image is the title there.
   The archive hero needs a readable title under the logo, so un-hide it. */
.hero-archive .hero-title
  position static
  width auto
  height auto
  margin 20px 0 12px
  padding 0
  overflow visible
  clip auto
  white-space normal
  font-size 2.4rem
  font-weight 700
  line-height 1.2
  letter-spacing -0.02em

.hero-archive .hero-tagline
  max-width 620px

.hero-archive .hero-version
  margin-bottom 28px

.hero-archive .hero-version-date
  opacity 0.6

.hero-archive .hero-supports
  margin-top 24px
  margin-bottom 0

@media (max-width: 479px)
  .hero-archive
    padding 44px 0 48px
  .hero-archive .hero-title
    font-size 1.8rem

.hero-stats
  list-style none
  display grid
  grid-template-columns 1fr
  gap 16px
  width 100%
  max-width 720px
  margin-top 40px
  padding-top 28px
  border-top 1px solid var(--color-border)

@media (min-width: 600px)
  .hero-stats
    grid-template-columns repeat(3, 1fr)
    gap 24px

.hero-stats li
  display flex
  flex-direction column
  gap 2px

.hero-stats strong
  font-size 1.75rem
  font-weight 700
  line-height 1.1
  letter-spacing -0.02em

.hero-stats span
  font-size 0.85rem
  color var(--color-text-secondary)

/* --- "This is the release archive" cards --- */

.features.archive-about
  background var(--color-bg-alt)

/* --- Latest release callout --- */

.latest-release
  padding 0 0 80px
  background var(--color-bg-alt)

.latest-card
  display flex
  flex-direction column
  gap 24px
  padding 32px
  border 1px solid var(--color-border)
  border-left 4px solid var(--color-primary)
  border-radius var(--radius-lg)
  background var(--color-bg)
  box-shadow var(--shadow-md)

@media (min-width: 900px)
  .latest-card
    flex-direction row
    align-items center
    justify-content space-between
    gap 40px

.latest-badge
  display inline-block
  padding 3px 10px
  border-radius 999px
  background var(--color-primary-light)
  color var(--color-primary)
  font-size 0.72rem
  font-weight 600
  letter-spacing 0.04em
  text-transform uppercase
  margin-bottom 12px

.latest-card-body h2
  font-size 1.6rem
  letter-spacing -0.01em
  margin-bottom 8px

.latest-meta
  color var(--color-text-secondary)
  font-size 0.9rem
  margin-bottom 10px

.latest-note
  color var(--color-text-secondary)
  font-size 0.9rem
  max-width 520px

.latest-card-actions
  display flex
  flex-direction column
  gap 12px
  flex-shrink 0

@media (min-width: 480px)
  .latest-card-actions
    flex-direction row

@media (min-width: 900px)
  .latest-card-actions
    flex-direction column

/* --- Recent releases --- */

.recent-releases
  padding 80px 0

.recent-list
  list-style none
  display grid
  grid-template-columns 1fr
  max-width 880px
  margin 0 auto
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  overflow hidden

@media (min-width: 600px)
  .recent-list
    grid-template-columns repeat(2, 1fr)

.recent-item
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 12px 18px
  border-bottom 1px solid var(--color-border-light)
  font-size 0.9rem
  transition background 0.15s

.recent-item:hover
  background var(--color-bg-alt)

.recent-version
  font-family var(--font-mono)
  font-size 0.88rem
  font-weight 600

.recent-date
  color var(--color-text-secondary)
  font-size 0.82rem
  white-space nowrap

.recent-more
  text-align center
  margin-top 32px
