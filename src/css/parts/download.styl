/* ===== Download Section ===== */

.downloads
  padding 80px 0
  background var(--color-bg-alt)

.download-tabs-bar
  display flex
  flex-wrap wrap
  gap 4px
  background var(--color-border-light)
  border-radius var(--radius-md)
  padding 4px
  margin-bottom 32px
  max-width fit-content
  margin-left auto
  margin-right auto

  @media (max-width: 479px)
    max-width 100%

.download-tab-btn
  flex 1
  padding 10px 16px
  border none
  background none
  border-radius var(--radius-sm)
  font-size 0.9rem
  font-weight 500
  color var(--color-text-secondary)
  cursor pointer
  transition all 0.2s
  white-space nowrap
  min-width fit-content

  @media (max-width: 479px)
    flex 0 0 calc(50% - 2px)
    padding 8px 12px

.download-tab-btn.active
  background var(--color-bg)
  color var(--color-text)
  box-shadow var(--shadow-sm)

.download-tab-btn:hover:not(.active)
  color var(--color-text)

.beta-tag
  color var(--color-primary)
  font-size 0.7em
  font-weight 600
  margin-left 4px

.download-panel
  display none

.download-panel.active
  display block

.download-grid
  display grid
  grid-template-columns 1fr
  gap 12px

@media (min-width: 768px)
  .download-grid
    grid-template-columns repeat(2, 1fr)
    gap 16px

.download-card
  display flex
  align-items flex-start
  justify-content space-between
  padding 16px 20px
  background var(--color-bg)
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  transition all 0.2s
  flex-wrap wrap
  gap 12px

.download-card:hover
  border-color var(--color-primary)
  box-shadow var(--shadow-sm)

.download-card-top
  width 100%

.download-card-name
  font-weight 600
  font-size 0.95rem
  word-break break-all

.download-card-desc
  font-size 0.82rem
  color var(--color-text-secondary)
  margin-top 2px

.download-card-links
  display flex
  gap 6px
  flex-wrap wrap

.download-card-link
  padding 6px 12px
  border-radius var(--radius-sm)
  font-size 0.8rem
  font-weight 500
  border 1px solid var(--color-border)
  color var(--color-text-secondary)
  transition all 0.15s
  white-space nowrap

.download-card-link:hover
  border-color var(--color-primary)
  color var(--color-primary)

.download-card-link.primary
  background var(--color-primary)
  border-color var(--color-primary)
  color white

.download-card-link.primary:hover
  background var(--color-primary-dark)

.download-more
  text-align center
  margin-top 32px

.download-more-links
  display inline-flex
  flex-wrap wrap
  justify-content center
  gap 12px

.download-more a
  display inline-flex
  align-items center
  gap 6px
  padding 10px 20px
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  color var(--color-text-secondary)
  font-size 0.9rem
  font-weight 500
  transition all 0.2s

.download-more a:hover
  border-color var(--color-primary)
  color var(--color-primary)

@media (max-width: 479px)
  .download-card
    flex-direction column
  .download-card-links
    width 100%

/* ===== Arch switcher (release pages: Windows / Linux) ===== */

.arch-bar
  display flex
  flex-wrap wrap
  gap 6px
  margin-bottom 16px

.arch-btn
  padding 6px 12px
  border 1px solid var(--color-border)
  background var(--color-bg)
  border-radius 999px
  font-size 0.8rem
  font-weight 500
  color var(--color-text-secondary)
  cursor pointer
  transition all 0.15s
  white-space nowrap

.arch-btn:hover
  border-color var(--color-primary)
  color var(--color-primary)

.arch-btn.active
  background var(--color-primary)
  border-color var(--color-primary)
  color white

.arch-btn:focus-visible
  outline 2px solid var(--color-primary)
  outline-offset 2px

.arch-panel
  display none

.arch-panel.active
  display block

/* ===== Alternative install ways (brew / npm / snap / apt …) ===== */

.alt-install
  margin-top 20px
  background var(--color-bg)
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  padding 16px 20px

.alt-install-title
  font-weight 600
  font-size 0.9rem
  margin-bottom 12px

.alt-install-list
  display flex
  flex-direction column
  gap 12px

.alt-install-item
  border-top 1px solid var(--color-border-light)
  padding-top 12px

.alt-install-item:first-child
  border-top none
  padding-top 0

.alt-install-name
  font-weight 600
  font-size 0.82rem
  color var(--color-text-secondary)
  margin-bottom 8px

.alt-install-body
  display flex
  align-items stretch
  gap 8px

.alt-install-code
  flex 1
  min-width 0
  margin 0
  padding 10px 12px
  background var(--color-bg-alt)
  border 1px solid var(--color-border)
  border-radius var(--radius-sm)
  font-family var(--font-mono)
  font-size 0.8rem
  line-height 1.5
  overflow-x auto
  white-space pre

.alt-install-code code
  background none
  padding 0
  font-family inherit
  font-size inherit

.alt-copy
  flex-shrink 0
  align-self flex-start
  display inline-flex
  align-items center
  justify-content center
  gap 6px
  padding 8px 14px
  border 1px solid var(--color-border)
  border-radius var(--radius-sm)
  background var(--color-bg)
  color var(--color-text-secondary)
  font-size 0.8rem
  font-weight 500
  line-height 1.5
  cursor pointer
  transition all 0.15s
  white-space nowrap

.alt-copy:hover
  border-color var(--color-primary)
  color var(--color-primary)

.alt-copy:active
  transform translateY(1px)

.alt-copy:focus-visible
  outline 2px solid var(--color-primary)
  outline-offset 2px

.alt-copy.copied
  background var(--color-success)
  border-color var(--color-success)
  color white

.alt-install-link
  display inline-block
  margin-top 8px
  font-size 0.8rem
  color var(--color-primary)
  word-break break-all

.alt-install-link:hover
  text-decoration underline

@media (max-width: 479px)
  .alt-install
    padding 12px 14px
  .alt-install-body
    flex-direction column
    align-items stretch
  .alt-copy
    align-self stretch
    width 100%
